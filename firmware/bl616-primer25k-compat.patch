+static void set_fpga_uart_baud(uint32_t baud)
+{
+    struct bflb_uart_config_s cfg = {
+        .baudrate = baud,
+        .direction = UART_DIRECTION_TXRX,
+        .data_bits = UART_DATA_BITS_8,
+        .stop_bits = UART_STOP_BITS_1,
+        .parity = UART_PARITY_NONE,
+        .bit_order = UART_LSB_FIRST,
+        .flow_ctrl = 0,
+        .tx_fifo_threshold = 7,
+        .rx_fifo_threshold = 7,
+    };
+    bflb_uart_init(uart1_dev, &cfg);
+}
+
+static void diagnostic_write(FIL *file, const char *format, ...)
+{
+    va_list args;
+    va_start(args, format);
+    int length = vsnprintf(diagnostic_line, sizeof(diagnostic_line), format, args);
+    va_end(args);
+    if (length < 0)
+        return;
+    if ((size_t)length >= sizeof(diagnostic_line))
+        length = sizeof(diagnostic_line) - 1;
+    UINT written;
+    f_write(file, diagnostic_line, length, &written);
+}
+
+void controller_diagnostic_start(void)
+{
+    controller_report_mutex = xSemaphoreCreateMutex();
+    if (!controller_report_mutex)
+        return;
+    if (f_open(&controller_report, "usb:controller-diagnostic.txt",
+               FA_CREATE_ALWAYS | FA_WRITE) != FR_OK)
+        return;
+    controller_report_open = true;
+    controller_diagnostic_log("controller logging started; press every button and direction\r\n");
+}
+
+void controller_diagnostic_log(const char *format, ...)
+{
+    if (!controller_report_open || !controller_report_mutex)
+        return;
+    if (xSemaphoreTake(controller_report_mutex, pdMS_TO_TICKS(1000)) != pdTRUE)
+        return;
+
+    int prefix = snprintf(controller_line, sizeof(controller_line), "[%lu ms] ",
+                          (unsigned long)bflb_mtimer_get_time_ms());
+    va_list args;
+    va_start(args, format);
+    int body = vsnprintf(controller_line + prefix, sizeof(controller_line) - prefix,
+                         format, args);
+    va_end(args);
+    if (body < 0)
+        body = 0;
+    int length = prefix + body;
+    if ((size_t)length >= sizeof(controller_line))
+        length = sizeof(controller_line) - 1;
+    UINT written;
+    f_write(&controller_report, controller_line, length, &written);
+    f_sync(&controller_report);
+    xSemaphoreGive(controller_report_mutex);
+}
+
+void controller_diagnostic_stop(void)
+{
+    if (!controller_report_open || !controller_report_mutex)
+        return;
+    if (xSemaphoreTake(controller_report_mutex, pdMS_TO_TICKS(1000)) != pdTRUE)
+        return;
+    f_sync(&controller_report);
+    f_close(&controller_report);
+    controller_report_open = false;
+    xSemaphoreGive(controller_report_mutex);
+}
+
+void storage_diagnostic_log(const char *format, ...)
+{
+    if (f_open(&storage_report, "usb:rom-diagnostic.txt",
+               FA_OPEN_APPEND | FA_WRITE) != FR_OK)
+        return;
+
+    int prefix = snprintf(storage_line, sizeof(storage_line), "[%lu ms] ",
+                          (unsigned long)bflb_mtimer_get_time_ms());
+    va_list args;
+    va_start(args, format);
+    int body = vsnprintf(storage_line + prefix, sizeof(storage_line) - prefix,
+                         format, args);
+    va_end(args);
+    if (body < 0)
+        body = 0;
+    int length = prefix + body;
+    if ((size_t)length >= sizeof(storage_line))
+        length = sizeof(storage_line) - 1;
+    UINT written;
+    f_write(&storage_report, storage_line, length, &written);
+    f_sync(&storage_report);
+    f_close(&storage_report);
+}
+
+static void run_usb_uart_diagnostic(void)
+{
+    FRESULT open_result = f_open(&diagnostic_report, "usb:tangcore-diagnostic.txt",
+                                 FA_CREATE_ALWAYS | FA_WRITE);
+    if (open_result != FR_OK) {
+        debug_uart_log("DIAGNOSTIC: could not create USB report");
+        return;
+    }
+
+    diagnostic_write(&diagnostic_report, "TangCore Primer 25K USB/UART diagnostic\r\n");
+    diagnostic_write(&diagnostic_report, "Build: %s %s\r\n", __DATE__, __TIME__);
+    diagnostic_write(&diagnostic_report, "MCU clock=%lu UART1 clock=%lu\r\n",
+                     (unsigned long)bflb_clk_get_system_clock(BL_SYSTEM_CLOCK_MCU_CLK),
+                     (unsigned long)Clock_Peripheral_Clock_Get(BL_PERIPHERAL_CLOCK_UART1));
+    diagnostic_write(&diagnostic_report, "GPIO10_CFG=%08lx GPIO11_CFG=%08lx\r\n",
+                     (unsigned long)*(volatile uint32_t *)0x200008ec,
+                     (unsigned long)*(volatile uint32_t *)0x200008f0);
+
+    // The first USB report proved the electrical link is exactly 2 Mbps.
+    // Keep the on-drive test at that known-good rate; malformed bytes from
+    // deliberately wrong rates are not useful and can confuse old parsers.
+    const uint32_t bauds[] = { 2000000 };
+    for (unsigned test = 0; test < sizeof(bauds) / sizeof(bauds[0]); test++) {
+        taskENTER_CRITICAL();
+        uart1_rx_bytes = 0;
+        uart1_rx_status = 0;
+        uart1_rx_raw_len = 0;
+        uart1_reset_parser = true;
+        core_id = -1;
+        taskEXIT_CRITICAL();
+
+        set_fpga_uart_baud(bauds[test]);
+        delay(100);
+        for (int request = 0; request < 4; request++) {
+            fpga_tx_header(0x01, 1);
+            delay(150);
+        }
+
+        taskENTER_CRITICAL();
+        uint32_t count = uart1_rx_bytes;
+        uint32_t status = uart1_rx_status;
+        uint32_t raw_len = uart1_rx_raw_len;
+        int16_t observed_core = core_id;
+        uint8_t raw[128];
+        memcpy(raw, uart1_rx_raw, raw_len);
+        taskEXIT_CRITICAL();
+
+        diagnostic_write(&diagnostic_report,
+                         "\r\nbaud=%lu bit_prd=%08lx rx_bytes=%lu int_status=%08lx core_id=%d\r\nraw:",
+                         (unsigned long)bauds[test],
+                         (unsigned long)*(volatile uint32_t *)0x2000a108,
+                         (unsigned long)count, (unsigned long)status,
+                         (int)observed_core);
+        for (uint32_t i = 0; i < raw_len; i++)
+            diagnostic_write(&diagnostic_report, " %02x", raw[i]);
+        diagnostic_write(&diagnostic_report, "\r\n");
+        f_sync(&diagnostic_report);
+    }
+
+    set_fpga_uart_baud(2000000);
+    diagnostic_write(&diagnostic_report, "\r\nDIAGNOSTIC COMPLETE\r\n");
+    f_sync(&diagnostic_report);
+    f_close(&diagnostic_report);
+
+    overlay_clear();
+    overlay_cursor(5, 13);
+    overlay_printf("DIAGNOSTIC COMPLETE");
+    debug_uart_log("DIAGNOSTIC COMPLETE; report saved to USB");
+}
