 void fpga_tx_header(int cmd, int len) {
+#ifdef TANG_PRIMER25K
+    // TangCore 0.7's packaged Primer cores predate the framed protocol used by
+    // the source tree: command byte directly, with a 24-bit length only for
+    // ROM data. `len` includes the command byte in the newer API.
+    bflb_uart_putchar(uart1_dev, cmd);
+    if (cmd == 0x07) {
+        uint32_t data_len = len - 1;
+        bflb_uart_putchar(uart1_dev, data_len >> 16);
+        bflb_uart_putchar(uart1_dev, data_len >> 8);
+        bflb_uart_putchar(uart1_dev, data_len);
+    }
+#else
     bflb_uart_putchar(uart1_dev, 0xAA);
     bflb_uart_putchar(uart1_dev, len >> 8);
     bflb_uart_putchar(uart1_dev, len & 0xFF);
     bflb_uart_putchar(uart1_dev, cmd);
+#endif
 }
 
