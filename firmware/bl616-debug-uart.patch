diff --git a/utils/debug_uart.cpp b/utils/debug_uart.cpp
new file mode 100644
index 0000000..ab1b711
--- /dev/null
+++ b/utils/debug_uart.cpp
@@ -0,0 +1,311 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern "C" {
+#include "bflb_gpio.h"
+#include "bflb_irq.h"
+#include "bflb_mtimer.h"
+#include "board.h"
+}
+
+#include "FreeRTOS.h"
+#include "task.h"
+
+#include "debug_uart.h"
+#include "utils.h"
+
+#ifdef TANG_PRIMER25K
+
+namespace {
+
+// The Primer has a 26 MHz crystal, while this SDK configures mtimer as if it
+// were 40 MHz. A requested delay therefore lasts 40/26 times as long. Request
+// 68 timer "microseconds" to produce a physical 104.6 us bit (about 9559 baud).
+uint32_t debug_uart_bit_us = 68;
+
+// Soak: multimeter-readable pattern. Confirmed working 2026-08-29, so off.
+#define DEBUG_UART_SOAK 0
+
+// Sweep: walk the bit period across candidates, sending a different letter at
+// each, so a listener fixed at 9600 reveals which period is actually 9600.
+#define DEBUG_UART_SWEEP 0
+#define SWEEP_FIRST_US   40
+#define SWEEP_STEP_US     5
+#define SWEEP_STEPS      15
+
+// Calibration: time the delay the UART actually uses, with interrupts enabled
+// and then disabled exactly as transmit_byte() does it.
+#define DEBUG_UART_CALIBRATE 0
+#define CAL_CALLS 73530u   /* nominal 5 s if one call really costs 68 us */
+constexpr size_t DEBUG_BUFFER_SIZE = 4096;
+
+char debug_buffer[DEBUG_BUFFER_SIZE];
+size_t debug_buffer_read;
+size_t debug_buffer_write;
+bool debug_uart_active;
+bool debug_buffer_overflowed;
+
+void transmit_byte(uint8_t value)
+{
+    uintptr_t flags = bflb_irq_save();
+    bflb_gpio_reset(gpio_dev, GPIO_PIN_JTAG_TDI); // Start bit.
+    bflb_mtimer_delay_us(debug_uart_bit_us);
+    for (unsigned bit = 0; bit < 8; ++bit) {
+        if (value & (1U << bit)) {
+            bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+        } else {
+            bflb_gpio_reset(gpio_dev, GPIO_PIN_JTAG_TDI);
+        }
+        bflb_mtimer_delay_us(debug_uart_bit_us);
+    }
+    bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI); // Stop bit / idle.
+    bflb_mtimer_delay_us(debug_uart_bit_us);
+    bflb_irq_restore(flags);
+}
+
+void buffer_bytes(const char *data, size_t length)
+{
+    uintptr_t flags = bflb_irq_save();
+    for (size_t i = 0; i < length; ++i) {
+        size_t next = (debug_buffer_write + 1) % DEBUG_BUFFER_SIZE;
+        if (next == debug_buffer_read) {
+            debug_buffer_overflowed = true;
+            break;
+        }
+        debug_buffer[debug_buffer_write] = data[i];
+        debug_buffer_write = next;
+    }
+    bflb_irq_restore(flags);
+}
+
+char last_message[96];
+unsigned repeat_count;
+
+void emit_repeat_notice(void)
+{
+    if (repeat_count == 0) {
+        return;
+    }
+    char note[48];
+    int n = snprintf(note, sizeof(note), "  ... x%u\r\n", repeat_count + 1);
+    repeat_count = 0;
+    if (n > 0) {
+        buffer_bytes(note, (size_t)n);
+    }
+}
+
+void configure_tx_pin(void)
+{
+    bflb_gpio_init(gpio_dev, GPIO_PIN_JTAG_TDI,
+                   GPIO_OUTPUT | GPIO_FLOAT | GPIO_SMT_EN | GPIO_DRV_3);
+    bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+}
+
+// debug_uart_task is what normally drains the buffer, but it does not exist
+// until xTaskCreate() runs near the end of main(). Anything logged before the
+// scheduler starts -- including every message from usbh_initialize() and the
+// rest of init -- would otherwise sit in RAM and never reach the wire, and a
+// hang anywhere in that sequence would look identical to a dead UART. While
+// the scheduler is not running there is nothing to starve, so just transmit
+// synchronously.
+void flush_if_scheduler_stopped(void)
+{
+    if (!debug_uart_active) {
+        return;
+    }
+    if (xTaskGetSchedulerState() != taskSCHEDULER_NOT_STARTED) {
+        return;
+    }
+    while (debug_uart_drain_one()) {
+    }
+}
+
+} // namespace
+
+// Drive a pattern slow enough to read on a multimeter, using the real transmit
+// path rather than a plain GPIO write. A continuous stream of 0x00 frames is
+// low for 9 of every 10 bit times, so J7 pin 2 averages about 0.3 V; the idle
+// half of each cycle sits at 3.3 V. Three cycles of roughly 3 s each.
+//
+//   swings 0.3 V <-> 3.3 V  -> the software UART transmits; suspect the link
+//   stays at 3.3 V          -> the transmit path never drives the pin
+void debug_uart_soak(void)
+{
+    if (!debug_uart_active) {
+        return;
+    }
+    for (unsigned cycle = 0; cycle < 3; ++cycle) {
+        uint64_t end = bflb_mtimer_get_time_ms() + 2000;
+        while (bflb_mtimer_get_time_ms() < end) {
+            transmit_byte(0x00);
+        }
+        bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+        end = bflb_mtimer_get_time_ms() + 2000;
+        while (bflb_mtimer_get_time_ms() < end) {
+        }
+    }
+}
+
+// Send 'A' at SWEEP_FIRST_US, 'B' one step slower, and so on. The listener
+// stays at 9600 throughout; whichever letter arrives cleanly identifies the bit
+// period that really is 9600 on this board, overhead and clock ratio included.
+void debug_uart_sweep(void)
+{
+    const uint32_t saved = debug_uart_bit_us;
+    for (unsigned step = 0; step < SWEEP_STEPS; ++step) {
+        debug_uart_bit_us = SWEEP_FIRST_US + step * SWEEP_STEP_US;
+        const uint8_t letter = 'A' + step;
+        uint64_t end = bflb_mtimer_get_time_ms() + 1500;
+        while (bflb_mtimer_get_time_ms() < end) {
+            transmit_byte(letter);
+        }
+        debug_uart_bit_us = saved;
+        bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+        end = bflb_mtimer_get_time_ms() + 400;   // gap between steps
+        while (bflb_mtimer_get_time_ms() < end) {
+        }
+    }
+    debug_uart_bit_us = saved;
+}
+
+// Square wave on J7 pin 2 whose half-period is CAL_CALLS delay calls. Phase 1
+// runs them with interrupts enabled, phase 2 in batches of ten inside
+// bflb_irq_save(), the way transmit_byte() sends a frame. Separated by a 3 s
+// idle-high marker. Time a half-period in each phase; then
+//    real bit period (us) = half_period_seconds * 1e6 / CAL_CALLS
+// A phase 2 that races past phase 1 means the delay does not work with
+// interrupts off, which would put the real baud far above anything sweepable.
+void debug_uart_calibrate(void)
+{
+    for (unsigned phase = 0; phase < 2; ++phase) {
+        bflb_gpio_reset(gpio_dev, GPIO_PIN_JTAG_TDI);
+        for (unsigned half = 0; half < 4; ++half) {
+            if (phase == 0) {
+                for (unsigned i = 0; i < CAL_CALLS; ++i) {
+                    bflb_mtimer_delay_us(debug_uart_bit_us);
+                }
+            } else {
+                for (unsigned i = 0; i < CAL_CALLS / 10; ++i) {
+                    uintptr_t flags = bflb_irq_save();
+                    for (unsigned bit = 0; bit < 10; ++bit) {
+                        bflb_mtimer_delay_us(debug_uart_bit_us);
+                    }
+                    bflb_irq_restore(flags);
+                }
+            }
+            if (half & 1) {
+                bflb_gpio_reset(gpio_dev, GPIO_PIN_JTAG_TDI);
+            } else {
+                bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+            }
+        }
+        bflb_gpio_set(gpio_dev, GPIO_PIN_JTAG_TDI);
+        uint64_t end = bflb_mtimer_get_time_ms() + 3000;
+        while (bflb_mtimer_get_time_ms() < end) {
+        }
+    }
+}
+
+void debug_uart_init(void)
+{
+    configure_tx_pin();
+    debug_uart_active = true;
+#if DEBUG_UART_CALIBRATE
+    debug_uart_calibrate();
+#endif
+#if DEBUG_UART_SOAK
+    debug_uart_soak();
+#endif
+#if DEBUG_UART_SWEEP
+    debug_uart_sweep();
+#endif
+    debug_uart_log("[debug] J7 pin 2 software UART TX ready: 9600 8N1");
+}
+
+void debug_uart_suspend(void)
+{
+    if (!debug_uart_active) {
+        return;
+    }
+    debug_uart_active = false;
+    bflb_gpio_deinit(gpio_dev, GPIO_PIN_JTAG_TDI);
+}
+
+void debug_uart_resume(void)
+{
+    configure_tx_pin();
+    debug_uart_active = true;
+
+    if (debug_buffer_overflowed) {
+        static const char warning[] = "[debug] buffered output truncated\r\n";
+        buffer_bytes(warning, sizeof(warning) - 1);
+        debug_buffer_overflowed = false;
+    }
+}
+
+void debug_uart_putchar(char character)
+{
+    buffer_bytes(&character, 1);
+    flush_if_scheduler_stopped();
+}
+
+void debug_uart_log(const char *message)
+{
+    if (message == nullptr) {
+        return;
+    }
+
+    // main_task re-emits "core_id=-1" about five times a second while no core
+    // answers, which scrolls everything else off a small display. Collapse runs
+    // of identical lines into one plus a count.
+    if (strncmp(message, last_message, sizeof(last_message) - 1) == 0) {
+        if (repeat_count < 65535u) {
+            repeat_count++;
+        }
+        return;
+    }
+    emit_repeat_notice();
+    strncpy(last_message, message, sizeof(last_message) - 1);
+    last_message[sizeof(last_message) - 1] = '\0';
+
+    const size_t length = strlen(message);
+    const bool needs_newline = length == 0 || message[length - 1] != '\n';
+    buffer_bytes(message, length);
+    if (needs_newline) {
+        buffer_bytes("\r\n", 2);
+    }
+    flush_if_scheduler_stopped();
+}
+
+bool debug_uart_drain_one(void)
+{
+    if (!debug_uart_active) {
+        return false;
+    }
+
+    uintptr_t flags = bflb_irq_save();
+    if (debug_buffer_read == debug_buffer_write) {
+        bflb_irq_restore(flags);
+        return false;
+    }
+    uint8_t value = debug_buffer[debug_buffer_read];
+    debug_buffer_read = (debug_buffer_read + 1) % DEBUG_BUFFER_SIZE;
+    bflb_irq_restore(flags);
+    transmit_byte(value);
+    return true;
+}
+
+#else
+
+void debug_uart_init(void) {}
+void debug_uart_suspend(void) {}
+void debug_uart_resume(void) {}
+void debug_uart_putchar(char) {}
+void debug_uart_log(const char *) {}
+bool debug_uart_drain_one(void) { return false; }
+void debug_uart_soak(void) {}
+void debug_uart_calibrate(void) {}
+
+#endif
