+TaskHandle_t debug_uart_task_handle;
+
+static void debug_uart_task(void *)
+{
+    unsigned heartbeat = 0;
+    uint64_t next_heartbeat = bflb_mtimer_get_time_ms();
+    while (1) {
+        uint64_t now = bflb_mtimer_get_time_ms();
+        if (now >= next_heartbeat) {
+            char message[64];
+            snprintf(message, sizeof(message), "[debug] heartbeat %u", heartbeat++);
+            debug_uart_log(message);
+            next_heartbeat = now + 10000;
+        }
+        if (!debug_uart_drain_one()) {
+            delay(1);
+        }
+    }
+}
 
